<%= render "shared/page_header", title: "Entradas", subtitle: "Registro de entradas al almacén" %>

<div class="row g-4">
  <div class="col-lg-7">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body p-4">
        <h2 class="h5 mb-3">Nueva entrada</h2>
        <%= form_with url: entradas_path, method: :post do %>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Proyecto (C.C.)</label>
              <%= select_tag :id_proyecto,
                    options_from_collection_for_select(@proyectos, :id_proyecto, :nombre_obra_with_cc),
                    class: "form-select", required: true, include_blank: "Selecciona..." %>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Responsable</label>
              <%= text_field_tag :responsable, params[:responsable], class: "form-control", required: true %>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Observaciones</label>
            <%= text_area_tag :observaciones, params[:observaciones], class: "form-control", rows: 2 %>
          </div>

          <h3 class="h6">Líneas (hasta 5)</h3>
          <% 5.times do |i| %>
            <div class="border rounded p-3 mb-3 bg-light">
              <div class="form-check mb-2">
                <%= check_box_tag "items[#{i}][is_new]", "1", false, class: "form-check-input", id: "items_#{i}_is_new" %>
                <label class="form-check-label" for="items_<%= i %>_is_new">Artículo nuevo</label>
              </div>
              <div class="row g-2">
                <div class="col-md-6">
                  <label class="form-label">Artículo existente</label>
                  <%= select_tag "items[#{i}][id_articulo]",
                        options_from_collection_for_select(@articulos, :id_articulo, :nombre),
                        class: "form-select", include_blank: "—" %>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Nombre (si nuevo)</label>
                  <%= text_field_tag "items[#{i}][nombre]", nil, class: "form-control" %>
                </div>
                <div class="col-md-3">
                  <label class="form-label">Tipo</label>
                  <%= select_tag "items[#{i}][tipo]", options_for_select(%w[material herramienta]), class: "form-select" %>
                </div>
                <div class="col-md-3">
                  <label class="form-label">Cantidad</label>
                  <%= number_field_tag "items[#{i}][cantidad]", nil, class: "form-control", step: :any, min: 0 %>
                </div>
                <div class="col-md-3">
                  <label class="form-label">Unidad</label>
                  <%= select_tag "items[#{i}][unidad_medida]", options_for_select(ApplicationHelper::UNIDADES), class: "form-select", include_blank: true %>
                </div>
                <div class="col-md-3">
                  <label class="form-label">Precio</label>
                  <%= number_field_tag "items[#{i}][precio_unitario]", nil, class: "form-control", step: :any %>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Categoría</label>
                  <%= select_tag "items[#{i}][categoria]", options_for_select(Articulo::CATEGORIAS), class: "form-select", include_blank: true %>
                </div>
                <div class="col-md-2">
                  <label class="form-label">Stock mín.</label>
                  <%= number_field_tag "items[#{i}][stock_minimo]", nil, class: "form-control", step: :any %>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                  <div class="form-check mb-2">
                    <%= check_box_tag "items[#{i}][es_cable]", "1", false, class: "form-check-input", id: "items_#{i}_es_cable" %>
                    <label class="form-check-label" for="items_<%= i %>_es_cable">Cable</label>
                  </div>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Punta (cable)</label>
                  <%= text_field_tag "items[#{i}][nombre_punta]", nil, class: "form-control" %>
                </div>
                <div class="col-md-3">
                  <label class="form-label">Longitud</label>
                  <%= number_field_tag "items[#{i}][longitud]", nil, class: "form-control", step: :any %>
                </div>
                <div class="col-md-3">
                  <label class="form-label">Color</label>
                  <%= text_field_tag "items[#{i}][color]", nil, class: "form-control" %>
                </div>
              </div>
            </div>
          <% end %>

          <%= submit_tag "Registrar entrada", class: "btn btn-primary", data: { turbo_confirm: "¿Confirmar entrada?" } %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <h2 class="h5 mb-3">Entradas recientes</h2>
        <div class="list-group list-group-flush">
          <% @recent.each do |m| %>
            <div class="list-group-item px-0">
              <div class="fw-semibold">#<%= m.id_movimiento %> · <%= m.fecha_hora&.strftime("%Y-%m-%d %H:%M") %></div>
              <div class="small text-secondary"><%= m.proyecto && proyecto_label(m.proyecto) %> · <%= m.responsable %></div>
              <ul class="small mb-0">
                <% m.detalle_movimientos.each do |d| %>
                  <li><%= d.articulo&.nombre %>: <%= d.cantidad %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
          <% if @recent.empty? %>
            <p class="text-secondary mb-0">Sin entradas aún.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
