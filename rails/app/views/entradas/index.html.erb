<%= render "shared/page_header", title: "Entradas", subtitle: "Registro de entradas al almacén" %>

<%= render "movements/recent_panel", title: "Movimientos de entrada recientes", recent: @recent %>

<% if @pending_confirmation %>
  <%= render "movements/confirm_panel",
        noun: "entrada",
        items: @cart_items,
        accept_path: entradas_path,
        dismiss_path: dismiss_confirmation_entradas_path %>
<% elsif @form_open %>
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white border-0 pt-3 pb-0">
      <h2 class="h5 mb-0">Nueva entrada de inventario</h2>
    </div>
    <div class="card-body p-4">
      <%= form_with url: add_item_entradas_path, method: :post, class: "mb-0" do %>
        <section class="mb-4">
          <h3 class="h6 mb-3">
            <span class="badge badge-usse me-1">1</span>
            Proyecto y responsable
          </h3>
          <%= render "movements/project_selector", proyectos: @proyectos, selected: @cart["id_proyecto"] %>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Responsable de la entrada</label>
              <%= text_field_tag :responsable, @cart["responsable"], class: "form-control" %>
            </div>
            <div class="col-md-6">
              <label class="form-label">Observaciones (opcional)</label>
              <%= text_area_tag :observaciones, @cart["observaciones"], class: "form-control", rows: 2 %>
            </div>
          </div>
        </section>

        <% if @cart_items.any? %>
          <section class="mb-4">
            <h3 class="h6 mb-3">
              <span class="badge badge-usse me-1">2</span>
              Ítems en esta entrada
              <span class="badge text-bg-light text-secondary"><%= @cart_items.size %></span>
            </h3>
            <%= render "movements/cart_table",
                  items: @cart_items,
                  remove_path: ->(idx) { remove_item_entradas_path(index: idx) } %>
          </section>
        <% end %>

        <section class="mb-4">
          <h3 class="h6 mb-3">
            <span class="badge badge-usse me-1"><%= @cart_items.any? ? 3 : 2 %></span>
            Agregar ítem
          </h3>
          <div data-controller="item-form">
            <div class="mb-3">
              <label class="form-label">Selecciona un item existente o crea uno nuevo</label>
              <select name="id_articulo" class="form-select"
                      data-item-form-target="articleSelect"
                      data-action="change->item-form#refresh">
                <option value="">Selecciona...</option>
                <option value="__new__">Otro (escribir nuevo)</option>
                <% @articulos.each do |a| %>
                  <option value="<%= a.id_articulo %>" data-es-cable="<%= a.es_cable? %>">
                    <%= a.nombre %>
                  </option>
                <% end %>
              </select>
            </div>

            <%= render "movements/new_item_fields", show_precio: true, id_prefix: "entrada" %>
            <%= render "movements/cable_fields" %>

            <div class="mb-0 d-none" data-item-form-target="quantityFields">
              <label class="form-label">Cantidad a agregar</label>
              <div class="col-md-4 px-0">
                <%= number_field_tag :cantidad, 0, class: "form-control", step: :any, min: 0, disabled: true %>
              </div>
            </div>
          </div>
        </section>

        <div class="d-flex flex-wrap gap-2 pt-3 border-top">
          <%= submit_tag "Agregar item", class: "btn btn-outline-primary" %>
          <%= submit_tag "Finalizar entrada", formaction: finalize_entradas_path, class: "btn btn-primary" %>
          <%= link_to "Cancelar", cancel_entradas_path, data: { turbo_method: :delete }, class: "btn btn-outline-danger" %>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="mb-4">
    <%= button_to "Iniciar nueva entrada", start_entradas_path, method: :post, class: "btn btn-primary btn-lg" %>
  </div>
<% end %>
