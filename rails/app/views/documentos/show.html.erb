<% content_for :title, "Documentos" %>
<%= render "shared/page_header", title: "Documentos", subtitle: @trabajador.nombre %>

<% if @documento.errors.any? %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% @documento.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="card shadow-sm border-0">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-striped table-hover table-sm mb-0 align-middle">
        <thead>
          <tr>
            <th>Documento</th>
            <th>Archivo</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% Documento::FILE_FIELDS.each do |field| %>
            <% attachment = @documento.public_send(field) %>
            <tr>
              <td><%= Documento::LABELS[field.to_s] %></td>
              <td>
                <% if attachment.attached? %>
                  <%= attachment.filename %>
                <% else %>
                  <span class="text-secondary">Sin archivo</span>
                <% end %>
              </td>
              <td class="text-end">
                <div class="d-flex flex-wrap justify-content-end align-items-center gap-2">
                  <% if attachment.attached? && attachment.blob.persisted? %>
                    <%= link_to "Ver", rails_blob_path(attachment, disposition: "inline"),
                          class: "btn btn-sm btn-outline-secondary", target: "_blank", rel: "noopener" %>
                    <%= link_to "Descargar", rails_blob_path(attachment, disposition: "attachment"),
                          class: "btn btn-sm btn-outline-secondary" %>
                  <% end %>
                  <%= form_with url: trabajador_documentos_path(@trabajador), method: :patch, multipart: true,
                        class: "d-flex flex-wrap gap-2 justify-content-end" do %>
                    <%= hidden_field_tag :campo, field %>
                    <%= file_field_tag :archivo, accept: "application/pdf,image/png", class: "form-control form-control-sm", style: "max-width: 16rem;" %>
                    <%= submit_tag(attachment.attached? ? "Reemplazar" : "Agregar", class: "btn btn-sm btn-primary") %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="mt-3">
  <%= link_to "Volver", trabajadores_path, class: "btn btn-outline-secondary" %>
</div>
