<%# locals: title, description %>
<%= render "shared/page_header", title: title, subtitle: description %>

<div class="card shadow-sm border-0">
  <div class="card-body p-4">
    <h2 class="h5">Próximamente</h2>
    <p class="text-secondary mb-3">
      Esta sección se implementará en una etapa posterior. El diseño usa Bootstrap 5
      (tablas, formularios y botones estándar de la app).
    </p>
    <div class="table-responsive">
      <table class="table table-striped table-hover table-sm mb-0 align-middle">
        <thead>
          <tr>
            <th>Ejemplo</th>
            <th>Estado</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Contenido de <%= title.downcase %></td>
            <td><span class="badge text-bg-secondary">pendiente</span></td>
            <td class="text-end">
              <button type="button" class="btn btn-sm btn-outline-secondary" disabled>Acción</button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="mt-3">
      <button type="button" class="btn btn-primary" disabled>Acción principal</button>
      <button type="button" class="btn btn-outline-secondary" disabled>Cancelar</button>
    </div>
  </div>
</div>
