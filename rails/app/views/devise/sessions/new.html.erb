<% content_for :title, "Iniciar sesión" %>

<div class="card shadow-sm border-0">
  <div class="card-body p-4">
    <h2 class="h5 mb-3">Iniciar sesión</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mb-3">
        <%= f.label :username, "Usuario", class: "form-label" %>
        <%= f.text_field :username, autofocus: true, autocomplete: "username", class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= f.label :password, "Contraseña", class: "form-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form-check mb-3">
          <%= f.check_box :remember_me, class: "form-check-input" %>
          <%= f.label :remember_me, "Recordarme", class: "form-check-label" %>
        </div>
      <% end %>

      <%= f.submit "Entrar", class: "btn btn-primary w-100" %>
    <% end %>
  </div>
</div>
