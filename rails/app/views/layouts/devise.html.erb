<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Almacén USSE" : "Iniciar sesión · Almacén USSE" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "bootstrap.bundle.min", "data-turbo-track": "reload", defer: true %>
  </head>
  <body class="bg-light">
    <main class="container py-5">
      <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
          <div class="text-center mb-4">
            <%= image_tag "logo_usse_2.jpg", alt: "USSE", class: "app-logo mb-2" %>
            <h1 class="h4 mb-0">Almacén USSE</h1>
            <p class="text-secondary mb-0">Acceso al sistema</p>
          </div>
          <%= render "shared/flashes" %>
          <%= yield %>
        </div>
      </div>
    </main>
  </body>
</html>
