<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Almacén USSE" : "Almacén USSE" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="<%= image_path("logo_usse_2.jpg") %>" type="image/jpeg">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "bootstrap.bundle.min", "data-turbo-track": "reload", defer: true %>
  </head>
  <body class="bg-light">
    <main class="container py-5">
      <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
          <div class="text-center mb-4">
            <%= image_tag "logo_usse_2.jpg", alt: "USSE", class: "app-logo mb-2" %>
            <h1 class="h4 mb-0">USSE Online</h1>
          </div>
          <%= render "shared/flashes" %>
          <div class="card shadow-sm border-0">
            <div class="card-body p-4">
              <%= yield %>
            </div>
          </div>
          <% if user_signed_in? %>
            <div class="text-center mt-3">
              <%= button_to "Cerrar sesión", destroy_user_session_path, method: :delete,
                    class: "btn btn-link btn-sm text-secondary" %>
            </div>
          <% end %>
        </div>
      </div>
    </main>
  </body>
</html>
